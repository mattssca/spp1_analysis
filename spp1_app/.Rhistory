# Load your data
load("data/expr_data_getmm.Rdata")
load("data/metadata.Rdata")
create_spp1_correlation_volcano <- function(expr_data,
this_metadata,
cell_line = NULL,
spp1_profile = NULL,
cisplatine = NULL,
comment = NULL,
replicate = NULL,
cor_threshold = 0.5,
pval_threshold = 0.05) {
# Filter metadata based on selections
meta_sub <- this_metadata
if (!is.null(cell_line)) meta_sub <- meta_sub %>% filter(cell_line %in% !!cell_line)
if (!is.null(spp1_profile)) meta_sub <- meta_sub %>% filter(spp1_profile %in% !!spp1_profile)
if (!is.null(cisplatine)) meta_sub <- meta_sub %>% filter(cisplatine %in% !!cisplatine)
if (!is.null(comment)) meta_sub <- meta_sub %>% filter(comment %in% !!comment)
if (!is.null(replicate)) meta_sub <- meta_sub %>% filter(replicate %in% !!replicate)
if (nrow(meta_sub) == 0) {
stop("No samples match the specified filters")
}
# Get expression data for selected samples
samples <- meta_sub$sample_id
expr_sub <- expr_data[, samples, drop = FALSE]
# Check if SPP1 exists
if (!"SPP1" %in% rownames(expr_sub)) {
stop("SPP1 not found in expression data")
}
# Get SPP1 expression
spp1_expr <- as.numeric(expr_sub["SPP1", ])
# Calculate correlation for each gene with SPP1
cor_results <- data.frame(
gene = rownames(expr_sub),
correlation = NA,
pvalue = NA,
stringsAsFactors = FALSE
)
for (i in 1:nrow(expr_sub)) {
gene_expr <- as.numeric(expr_sub[i, ])
# Skip if no variance
if (sd(gene_expr, na.rm = TRUE) == 0 || sd(spp1_expr, na.rm = TRUE) == 0) {
next
}
# Calculate Pearson correlation
cor_test <- cor.test(gene_expr, spp1_expr, method = "pearson")
cor_results$correlation[i] <- cor_test$estimate
cor_results$pvalue[i] <- cor_test$p.value
}
# Remove NA values and SPP1 itself
cor_results <- cor_results %>%
filter(!is.na(correlation), !is.na(pvalue), gene != "SPP1") %>%
mutate(
neg_log10_pval = -log10(pvalue),
significance = case_when(
pvalue < pval_threshold & correlation > cor_threshold ~ "Positive correlation",
pvalue < pval_threshold & correlation < -cor_threshold ~ "Negative correlation",
pvalue < pval_threshold ~ "Significant (weak correlation)",
TRUE ~ "Not significant"
)
)
# Define colors
color_mapping <- c(
"Positive correlation" = "#e41a1c",      # Red
"Negative correlation" = "#377eb8",      # Blue
"Significant (weak correlation)" = "#ff7f00",  # Orange
"Not significant" = "#999999"            # Gray
)
# Create volcano plot
p <- plot_ly(
cor_results,
x = ~correlation,
y = ~neg_log10_pval,
type = 'scatter',
mode = 'markers',
color = ~significance,
colors = color_mapping,
marker = list(
size = 5,
opacity = 0.6,
line = list(width = 0)
),
text = ~paste0(
"Gene: ", gene,
"<br>Correlation: ", round(correlation, 3),
"<br>P-value: ", format(pvalue, scientific = TRUE, digits = 3),
"<br>-log10(p): ", round(neg_log10_pval, 2)
),
hoverinfo = 'text'
) %>%
layout(
title = "Gene Correlation with SPP1",
xaxis = list(
title = "Pearson Correlation with SPP1",
zeroline = TRUE,
zerolinewidth = 2,
zerolinecolor = 'black'
),
yaxis = list(
title = "-log10(P-value)"
),
hovermode = 'closest',
showlegend = TRUE,
legend = list(title = list(text = "Significance"))
) %>%
# Add threshold lines
add_segments(
x = cor_threshold, xend = cor_threshold,
y = 0, yend = max(cor_results$neg_log10_pval),
line = list(color = "black", dash = "dash", width = 1),
showlegend = FALSE, inherit = FALSE
) %>%
add_segments(
x = -cor_threshold, xend = -cor_threshold,
y = 0, yend = max(cor_results$neg_log10_pval),
line = list(color = "black", dash = "dash", width = 1),
showlegend = FALSE, inherit = FALSE
) %>%
add_segments(
x = min(cor_results$correlation), xend = max(cor_results$correlation),
y = -log10(pval_threshold), yend = -log10(pval_threshold),
line = list(color = "black", dash = "dash", width = 1),
showlegend = FALSE, inherit = FALSE
)
return(list(
plot = p,
data = cor_results,
n_samples = ncol(expr_sub),
top_positive = cor_results %>%
filter(significance == "Positive correlation") %>%
arrange(desc(correlation)) %>%
head(10),
top_negative = cor_results %>%
filter(significance == "Negative correlation") %>%
arrange(correlation) %>%
head(10)
))
}
# Example 1: All samples
result1 <- create_spp1_correlation_volcano(
expr_data = expr_data_getmm,
this_metadata = metadata,
cor_threshold = 0.5,
pval_threshold = 0.05
)
result1$plot
# Example 3: Specific condition
result3 <- create_spp1_correlation_volcano(
expr_data = expr_data_getmm,
this_metadata = metadata,
cell_line = "SCaBER",
cisplatine = "No",
cor_threshold = 0.5,
pval_threshold = 0.05
)
result3$plot
# Example 2: Only VMCUB1 cell line
result2 <- create_spp1_correlation_volcano(
expr_data = expr_data_getmm,
this_metadata = metadata,
cell_line = "VMCUB1",
cor_threshold = 0.6,
pval_threshold = 0.01
)
